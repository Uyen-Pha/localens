{
  "name": "localens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/run-next-mode.mjs dev demo",
    "dev:supabase": "node scripts/run-next-mode.mjs dev supabase",
    "preview:static": "node scripts/static-preview-server.mjs",
    "build": "next build",
    "build:demo": "node scripts/run-next-mode.mjs build demo",
    "build:supabase": "node scripts/run-next-mode.mjs build supabase",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/run-demo-e2e.mjs",
    "test:e2e:runtime-auth": "node scripts/run-runtime-auth-isolated-e2e.mjs",
    "test:e2e:runtime-itinerary": "node scripts/run-runtime-itinerary-e2e.mjs",
    "test:e2e:runtime-fixed-tour": "node scripts/run-runtime-fixed-tour-e2e.mjs",
    "test:e2e:runtime-guide-assignment": "node scripts/run-runtime-guide-assignment-e2e.mjs",
    "db:static": "node scripts/check-supabase-artifacts.mjs",
    "db:static:seed": "node scripts/generate-supabase-seed.mjs --check-readiness",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:reset": "node scripts/supabase-local.mjs db reset --local",
    "db:seed:runtime-auth": "node scripts/seed-runtime-auth.mjs",
    "db:seed:runtime-fixed-tour": "node scripts/seed-runtime-fixed-tour.mjs",
    "db:lint": "node scripts/supabase-local.mjs db lint --local --level error --fail-on error",
    "db:test": "node scripts/supabase-local.mjs test db --local",
    "db:types": "node scripts/write-generated-db-types.mjs",
    "db:types:check": "node scripts/check-generated-db-types.mjs",
    "db:concurrency": "node scripts/test-db-concurrency.mjs",
    "db:planner-operation-concurrency": "node scripts/test-planner-operation-concurrency.mjs",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:verify": "node scripts/run-db-gate.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run --no-file-parallelism --testTimeout=30000 && pnpm db:static && pnpm build:demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "^1.40.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "yaml": "2.8.1"
  }
}
