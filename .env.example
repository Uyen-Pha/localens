# Browser-safe public configuration.
NEXT_PUBLIC_APP_URL=https://localens.example.com
# Deployments must choose demo or supabase explicitly.
NEXT_PUBLIC_LOCALLENS_RUNTIME=demo
# Replace this local/CI placeholder with the real public HTTPS URL before deployment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_replace_me

# Stripe, Gemini, Turnstile secret, Supabase service role, HMAC, and webhook
# secrets are Edge Function-only secrets. Never expose them as NEXT_PUBLIC
# browser variables.
